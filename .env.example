# ============================================
# EXEMPLO DE VARIAVEIS DE AMBIENTE
# ============================================
# Instrucoes:
# 1. Copie este arquivo para .env
#    cp .env.example .env
# 2. Preencha os valores reais
# 3. Exporte as variaveis no shell ou configure-as na IDE; o Spring nao carrega .env automaticamente
# 4. NUNCA commite o arquivo .env no git
# ============================================

# ============================================
# PROFILE ATIVO
# ============================================
# Valores de execucao: dev, prod
# - dev: H2 em memoria, logs detalhados, Swagger ativo
# - prod: PostgreSQL, logs minimos, Swagger desativado
# Os testes Maven usam configuracao isolada em src/test/resources.
SPRING_PROFILES_ACTIVE=dev

# ============================================
# JWT (JSON WEB TOKEN)
# ============================================
# Chave secreta para assinar tokens JWT
# MINIMO 32 caracteres (recomendado 64+)
# Gere uma chave segura com: openssl rand -base64 48
# IMPORTANTE: Use chaves diferentes em cada ambiente
JWT_SECRET=SuaChaveSecretaComPeloMenos32CaracteresAqui

# Tempo de expiracao do token em minutos (padrao: 60 minutos)
JWT_EXPIRATION_MINUTES=60

# ============================================
# BANCO DE DADOS
# ============================================
# Configuracoes para PostgreSQL (producao)
# Em desenvolvimento, o H2 em memoria e usado automaticamente

# URL de conexao JDBC
DB_URL=jdbc:postgresql://localhost:5432/raizesdb

# Credenciais do banco
DB_USERNAME=postgres
DB_PASSWORD=suaSenhaSeguraAqui

# Pool de conexoes HikariCP
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Origens permitidas (separadas por virgula)
# Desenvolvimento: localhost em diversas portas
# Producao: dominios reais da aplicacao
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Metodos HTTP permitidos
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Headers permitidos (* para todos)
CORS_ALLOWED_HEADERS=*

# Permitir envio de credenciais (cookies, Authorization)
CORS_ALLOW_CREDENTIALS=true

# Tempo de cache do preflight em segundos (1 hora)
CORS_MAX_AGE=3600

# ============================================
# PAGAMENTO (SIMULACAO)
# ============================================
# Forcar status do pagamento para testes deterministicos.
# Valores: APROVADO, RECUSADO, INDISPONIVEL ou vazio para resultado aleatorio.
# IMPORTANTE: Deixe VAZIO em producao para comportamento real
# Em desenvolvimento, use APROVADO para testes consistentes.
# Esta opcao e ignorada em producao.
PAGAMENTO_FORCAR_STATUS=APROVADO

# Forcar o resultado do estorno no gateway simulado.
# Valores: CONFIRMADO, INDISPONIVEL ou vazio para confirmacao normal do mock.
PAGAMENTO_FORCAR_STATUS_ESTORNO=CONFIRMADO

# Taxa de aprovacao quando em modo aleatorio (0.0 a 1.0)
PAGAMENTO_TAXA_APROVACAO=0.8

# ============================================
# LGPD - CONSENTIMENTO DE FIDELIDADE
# ============================================
# Alterar a versao invalida os consentimentos anteriores e exige novo aceite.
LGPD_TERMO_FIDELIDADE_VERSAO=1.0

# ============================================
# DOCUMENTOS LEGAIS DA PLATAFORMA
# ============================================
# A troca da versao vigente dos termos exige novo aceite contratual dos usuarios.
# Os arquivos correspondentes ficam em src/main/resources/legal.
TERMOS_USO_VERSAO=1.0
AVISO_PRIVACIDADE_VERSAO=1.0

# ============================================
# SERVER
# ============================================
# Porta do servidor (padrao: 8080)
SERVER_PORT=8080

# Context path da aplicacao
SERVER_CONTEXT_PATH=/api

# ============================================
# LOGGING
# ============================================
# Nivel de log geral
# Valores: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_ROOT=INFO

# Nivel de log do projeto
LOG_LEVEL_APP=DEBUG

# Nivel de log do Spring Security
LOG_LEVEL_SECURITY=WARN

# Nivel de log do Hibernate
LOG_LEVEL_HIBERNATE=WARN

# ============================================
# FLYWAY (MIGRACOES)
# ============================================
# Habilitar/desabilitar Flyway
FLYWAY_ENABLED=true

# Permitir clean (APAGAR em desenvolvimento)
# IMPORTANTE: NUNCA habilite em producao
FLYWAY_CLEAN_DISABLED=false

# ============================================
# SWAGGER/OPENAPI
# ============================================
# Habilitar Swagger UI
# IMPORTANTE: Desabilite em producao
SWAGGER_ENABLED=true

# ============================================
# H2 CONSOLE
# ============================================
# Habilitar console web do H2
# IMPORTANTE: Apenas em desenvolvimento
H2_CONSOLE_ENABLED=true

# ============================================
# EMAIL (FUTURO - NOTIFICACOES)
# ============================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seu-email@gmail.com
# MAIL_PASSWORD=sua-senha-de-aplicativo
# MAIL_FROM=noreply@raizesdonordeste.com.br

# ============================================
# REDIS (FUTURO - CACHE/SESSOES)
# ============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# MONITORAMENTO (FUTURO)
# ============================================
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE=health,info,metrics
# MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
